####### Compile

main.o: ../../src/main.cpp ../../src/audiocontroller.h \
		../../src/radiostate.h \
		../../src/signalingclient.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../src/main.cpp

audiocontroller.o: ../../src/audiocontroller.cpp ../../src/audiocontroller.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o audiocontroller.o ../../src/audiocontroller.cpp

radiostate.o: ../../src/radiostate.cpp ../../src/radiostate.h \
		../../src/audiocontroller.h \
		../../src/signalingclient.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o radiostate.o ../../src/radiostate.cpp

signalingclient.o: ../../src/signalingclient.cpp ../../src/signalingclient.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o signalingclient.o ../../src/signalingclient.cpp

moc_audiocontroller.o: moc_audiocontroller.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_audiocontroller.o moc_audiocontroller.cpp

moc_radiostate.o: moc_radiostate.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_radiostate.o moc_radiostate.cpp

moc_signalingclient.o: moc_signalingclient.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_signalingclient.o moc_signalingclient.cpp

